{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:p2-b:experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "experimentId", "sourceBaselineCommit", "graph06Enabled", "maximumLiveInvocations", "providers", "tasks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "experimentId": { "const": "INFOAPEX-P2-B" },
    "sourceBaselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "graph06Enabled": { "const": false },
    "maximumLiveInvocations": { "const": 10 },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude"],
      "properties": {
        "codex": { "$ref": "#/$defs/provider" },
        "claude": { "$ref": "#/$defs/provider" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "engine", "fallbackEngine", "contractIndex", "goal", "goalSha256", "expectedContractRef", "expectedExportedFunctions"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^PILOT-B-\\d{2}$" },
          "engine": { "enum": ["codex", "claude"] },
          "fallbackEngine": { "enum": ["codex", "claude"] },
          "contractIndex": { "type": "integer", "minimum": 1, "maximum": 5 },
          "goal": { "type": "string", "minLength": 1 },
          "goalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expectedContractRef": { "type": "string", "pattern": "^contracts/pilot-\\d\\.schema\\.json$" },
          "expectedExportedFunctions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "cliVersion"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": ["string", "null"] },
        "cliVersion": { "type": "string", "minLength": 1 }
      }
    }
  }
}
