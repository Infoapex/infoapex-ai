{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai:validation:p6:policy-manifest.schema.json",
  "title": "Infoapex AI release policy manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "commit", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "infoapex-ai-policy-manifest" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^\\\\/][^\\\\]*$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
