{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infoapex.dev/contracts/trace-ingest-manifest.v1.schema.json",
  "title": "Declared trace ingest manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documents"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "includeCodeIndex": { "type": "boolean", "default": true },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "canonicalRef"],
        "properties": {
          "kind": { "enum": ["adr", "contract", "plan", "source-map", "context-package", "relations"] },
          "path": { "type": "string", "minLength": 1 },
          "canonicalRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
