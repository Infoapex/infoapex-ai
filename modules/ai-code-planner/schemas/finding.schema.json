{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-planner:schemas:finding.schema.json",
  "title": "Finding",
  "description": "A structured finding produced by the ai-code-planner linter or consensus panel.",
  "type": "object",
  "required": ["id", "type", "severity", "claim", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable, unique identifier for this finding (e.g. FIND-001).",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "description": "Category of finding.",
      "enum": [
        "unverified-claim",
        "internal-contradiction",
        "omission",
        "over-claim",
        "style"
      ]
    },
    "severity": {
      "type": "string",
      "description": "Impact level of the finding.",
      "enum": ["blocker", "major", "minor"]
    },
    "claim": {
      "type": "string",
      "description": "Human-readable statement of the finding.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Lifecycle state of the finding.",
      "enum": [
        "proposed",
        "verified",
        "refuted",
        "accepted-as-assumption",
        "needs-human",
        "superseded"
      ]
    },
    "location": {
      "type": "object",
      "description": "Optional pointer to the artifact and position where the finding was raised.",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "description": "JSON Pointer (RFC 6901) into a structured artifact.",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
        }
      }
    },
    "supersededBy": {
      "type": "string",
      "description": "ID of the finding that replaces this one when status is 'superseded'.",
      "minLength": 1
    },
    "verification": {
      "type": "object",
      "description": "Optional verification record. Shell/command methods are not permitted.",
      "additionalProperties": false,
      "required": ["method", "evidence"],
      "properties": {
        "method": {
          "type": "string",
          "description": "How the finding was verified.",
          "enum": [
            "static-analysis",
            "schema-validation",
            "cross-reference",
            "human-review",
            "consensus-panel"
          ]
        },
        "evidence": {
          "type": "string",
          "description": "Human-readable or machine-readable evidence supporting the verification.",
          "minLength": 1
        },
        "verifiedBy": {
          "type": "string",
          "description": "Agent, tool, or person that performed verification.",
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of verification.",
          "format": "date-time"
        }
      }
    }
  }
}
