{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-docs:schemas:docs-config.schema.json",
  "title": "ai-code-docs project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planner", "worker", "control", "review", "defaultEngine", "defaultReviewEngine"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planner": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "worker": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "control": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "review": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "defaultEngine": { "enum": ["fake", "codex", "claude"] },
    "defaultReviewEngine": { "enum": ["fake", "codex", "claude"] }
  }
}
