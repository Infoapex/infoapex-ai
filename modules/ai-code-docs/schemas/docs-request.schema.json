{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-docs:schemas:docs-request.schema.json",
  "title": "ai-code-docs request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "docsId", "baseCommit", "headCommit", "prompt", "criteria", "outputPaths"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "docsId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
    "baseCommit": { "type": "string", "minLength": 1 },
    "headCommit": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "verify": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "outputPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "plannerDraftPath": { "type": "string", "minLength": 1 },
    "workerPlanPath": { "type": "string", "minLength": 1 },
    "reviewFixturePath": { "type": "string", "minLength": 1 }
  }
}
