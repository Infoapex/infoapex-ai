{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:independent-review.schema.json",
  "title": "ai-code-worker independent read-only review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "reviewId", "reviewer", "graphVersion", "createdAt", "verdict", "criterionCoverage", "findings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "reviewId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "graphVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": ["pass", "fail"]
    },
    "criterionCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "verdict", "tests", "commands", "evidence"],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": ["supported", "weak", "missing", "contradicted"]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "criterionIds", "files", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "severity": {
            "enum": ["blocking", "major", "minor", "note"]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "criterionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendedScope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
