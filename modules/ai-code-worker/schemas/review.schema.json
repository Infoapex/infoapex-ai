{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:review.schema.json",
  "title": "ai-code-worker review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "reviewer", "status", "coverageMatrix", "findings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["PASS", "FAIL", "REVIEW_REQUIRED"]
    },
    "coverageMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "test", "command", "evidence"],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "test": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {
            "enum": ["blocker", "major", "minor", "note"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
