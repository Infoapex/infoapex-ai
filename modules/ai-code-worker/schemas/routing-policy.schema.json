{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:routing-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "policyVersion": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidates", "reason", "confidence"],
        "properties": {
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine", "model"],
              "properties": {
                "engine": { "enum": ["codex", "claude"] },
                "model": { "type": ["string", "null"], "minLength": 1 }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
