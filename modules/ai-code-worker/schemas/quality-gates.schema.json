{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:quality-gates.schema.json",
  "title": "ai-code-worker quality gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gates"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "workingDirectory", "executable", "args", "timeoutSeconds", "allowedEnvironmentVariables"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "allowedEnvironmentVariables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "linkedDirectories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fromRepository", "toWorktree"],
              "properties": {
                "fromRepository": {
                  "type": "string",
                  "minLength": 1
                },
                "toWorktree": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
