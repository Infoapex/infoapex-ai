{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:usage-checkpoint.schema.json",
  "title": "ai-code-worker usage benchmark checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpointId",
    "runId",
    "taskId",
    "scope",
    "engine",
    "phase",
    "createdAt",
    "taskKind",
    "taskRisk",
    "tokens",
    "contextEstimateTokens",
    "percentUsedReported",
    "percentUsedEstimated"
  ],
  "properties": {
    "schemaVersion": {
      "enum": ["1.0", "1.1"]
    },
    "checkpointId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "scope": {
      "enum": ["run", "task", "development"]
    },
    "engine": {
      "enum": ["fake", "claude", "codex"]
    },
    "phase": {
      "enum": ["start", "end"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "taskKind": {
      "enum": ["contract", "backend", "frontend", "database", "docs", "test", "review", "repair", "other", null]
    },
    "taskRisk": {
      "enum": ["low", "medium", "high", null]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputUncachedTokens", "cacheReadTokens", "cacheWriteTokens", "outputTokens", "costUsd"],
      "properties": {
        "inputUncachedTokens": { "type": ["number", "null"] },
        "cacheReadTokens": { "type": ["number", "null"] },
        "cacheWriteTokens": { "type": ["number", "null"] },
        "outputTokens": { "type": ["number", "null"] },
        "costUsd": { "type": ["number", "null"] }
      }
    },
    "contextEstimateTokens": {
      "type": ["number", "null"]
    },
    "percentUsedReported": {
      "type": ["number", "null"]
    },
    "percentUsedEstimated": {
      "type": ["number", "null"]
    },
    "model": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "reasoningEffort": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "modelContextWindow": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "rateLimitWindowMinutes": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "rateLimitResetsAt": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "calibrationProfileId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "sessionFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{16}$"
    },
    "parallelSessionCount": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "prediction": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lowTokens", "medianTokens", "highTokens", "source"],
          "properties": {
            "lowTokens": { "type": "number", "minimum": 0 },
            "medianTokens": { "type": "number", "minimum": 0 },
            "highTokens": { "type": "number", "minimum": 0 },
            "source": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1.1" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "model": {},
          "reasoningEffort": {},
          "modelContextWindow": {},
          "rateLimitWindowMinutes": {},
          "rateLimitResetsAt": {},
          "calibrationProfileId": {},
          "sessionFingerprint": {},
          "parallelSessionCount": {},
          "prediction": {}
        },
        "required": [
          "model",
          "reasoningEffort",
          "modelContextWindow",
          "rateLimitWindowMinutes",
          "rateLimitResetsAt",
          "calibrationProfileId",
          "sessionFingerprint",
          "parallelSessionCount",
          "prediction"
        ]
      }
    }
  ]
}
