{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:run-authorization.schema.json",
  "title": "ai-code-worker immutable run authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "runId",
    "repositoryFingerprint",
    "planSha256",
    "manifestSha256",
    "baseCommit",
    "graphVersion",
    "executionEnvironment",
    "allowedCapabilities",
    "forbiddenCapabilities",
    "approvalMode",
    "limits",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "repositoryFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "planSha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseCommit": {
      "$ref": "#/$defs/gitOid"
    },
    "graphVersion": {
      "type": "integer",
      "minimum": 1
    },
    "executionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "kind", "profileSha256"],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["isolated", "trusted-local"]
        },
        "profileSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "allowedCapabilities": {
      "$ref": "#/$defs/capabilityList"
    },
    "forbiddenCapabilities": {
      "$ref": "#/$defs/capabilityList"
    },
    "approvalMode": {
      "enum": ["never", "on-risk", "always"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRunMinutes",
        "maximumAgentInvocations",
        "maximumInputUncachedTokens",
        "maximumCacheReadTokens",
        "maximumCacheWriteTokens",
        "maximumOutputTokens",
        "maximumCostUsd"
      ],
      "properties": {
        "maximumRunMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumAgentInvocations": {
          "type": "integer",
          "minimum": 1
        },
        "maximumInputUncachedTokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "maximumCacheReadTokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "maximumCacheWriteTokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "maximumOutputTokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "maximumCostUsd": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "capabilityList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "nullableCount": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  }
}
