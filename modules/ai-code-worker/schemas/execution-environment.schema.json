{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:execution-environment.schema.json",
  "title": "ai-code-worker execution environment profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "kind",
    "filesystem",
    "network",
    "environment",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": ["isolated", "trusted-local"]
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostReadDefault", "hostWriteDefault", "mounts"],
      "properties": {
        "hostReadDefault": {
          "enum": ["deny", "allow"]
        },
        "hostWriteDefault": {
          "enum": ["deny", "allow"]
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "access"],
            "properties": {
              "purpose": {
                "enum": ["worktree", "state", "evidence", "cache", "service-data", "other"]
              },
              "access": {
                "enum": ["read-only", "read-write"]
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryProcesses", "adapterControlPlane"],
      "properties": {
        "repositoryProcesses": {
          "enum": ["deny", "allowlist", "unrestricted"]
        },
        "adapterControlPlane": {
          "enum": ["provider-only", "allowlist", "deny"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inheritByDefault", "allowedVariables"],
      "properties": {
        "inheritByDefault": {
          "const": false
        },
        "allowedVariables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumDurationSeconds", "maximumOutputBytes", "maximumProcesses"],
      "properties": {
        "maximumDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maximumOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumProcesses": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "maximumMemoryBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "maximumCpuUnits": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": { "const": "isolated" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "filesystem": {
            "type": "object",
            "properties": {
              "hostReadDefault": { "const": "deny" },
              "hostWriteDefault": { "const": "deny" }
            }
          },
          "network": {
            "type": "object",
            "properties": {
              "repositoryProcesses": { "const": "deny" }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "maximumProcesses": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "trusted-local" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "filesystem": {
            "type": "object",
            "properties": {
              "hostReadDefault": { "const": "allow" },
              "hostWriteDefault": { "const": "allow" }
            }
          },
          "network": {
            "type": "object",
            "properties": {
              "repositoryProcesses": { "const": "unrestricted" }
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "maximumProcesses": { "const": null },
              "maximumMemoryBytes": { "const": null },
              "maximumCpuUnits": { "const": null }
            }
          }
        }
      }
    }
  ]
}
