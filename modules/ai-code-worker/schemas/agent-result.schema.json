{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:agent-result.schema.json",
  "title": "ai-code-worker agent result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "taskId", "status", "summary", "touchedFiles", "failures"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["DONE", "BLOCKED", "FAILED"]
    },
    "summary": {
      "type": "string"
    },
    "touchedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "message"],
        "properties": {
          "class": {
            "type": "string",
            "enum": ["deterministic", "flaky", "infrastructure", "policy", "engine"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
