{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:pilot-baseline.schema.json",
  "title": "ai-code-worker pilot baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "minimumDoneTasks",
    "maximumConsecutiveWorkerCausedFailures",
    "requiredComparableMetrics",
    "conditionalComparableMetrics",
    "thresholds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "minimumDoneTasks": {
      "type": "integer",
      "minimum": 1
    },
    "maximumConsecutiveWorkerCausedFailures": {
      "type": "integer",
      "minimum": 1
    },
    "requiredComparableMetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["elapsedTime", "humanActiveMinutes", "humanInterventions"]
      },
      "uniqueItems": true
    },
    "conditionalComparableMetrics": {
      "type": "array",
      "items": {
        "enum": ["reportedCostUsd"]
      },
      "uniqueItems": true
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumElapsedTimeRatio",
        "maximumReportedCostRatio",
        "maximumHumanActiveMinutesRatio",
        "maximumHumanInterventionsRatio",
        "maximumHumanInterventionsPerTask"
      ],
      "properties": {
        "maximumElapsedTimeRatio": {
          "type": "number",
          "minimum": 1
        },
        "maximumReportedCostRatio": {
          "type": "number",
          "minimum": 1
        },
        "maximumHumanActiveMinutesRatio": {
          "type": "number",
          "minimum": 1
        },
        "maximumHumanInterventionsRatio": {
          "type": "number",
          "minimum": 1
        },
        "maximumHumanInterventionsPerTask": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
