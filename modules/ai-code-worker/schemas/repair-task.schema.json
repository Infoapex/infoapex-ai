{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-worker:schemas:repair-task.schema.json",
  "title": "ai-code-worker repair task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "graphVersion",
    "sourceFindingIds",
    "allowedPaths",
    "forbiddenPaths",
    "verify",
    "dependsOn",
    "maximumAttempts",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]*$"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "graphVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceFindingIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedPaths": {
      "$ref": "#/$defs/pathList"
    },
    "forbiddenPaths": {
      "$ref": "#/$defs/pathList"
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maximumAttempts": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["PENDING", "READY", "RUNNING", "VERIFYING", "PASSED", "BLOCKED", "STALE", "SUPERSEDED", "CANCELLED"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
