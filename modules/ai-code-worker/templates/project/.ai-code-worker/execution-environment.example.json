{
  "schemaVersion": "1.0",
  "profileId": "isolated",
  "kind": "isolated",
  "providerExecution": {
    "mode": "simulated"
  },
  "filesystem": {
    "hostReadDefault": "deny",
    "hostWriteDefault": "deny",
    "mounts": [
      {
        "purpose": "worktree",
        "access": "read-write"
      },
      {
        "purpose": "evidence",
        "access": "read-write"
      }
    ]
  },
  "network": {
    "repositoryProcesses": "deny",
    "adapterControlPlane": "provider-only"
  },
  "environment": {
    "inheritByDefault": false,
    "allowedVariables": ["CI", "NO_COLOR"]
  },
  "limits": {
    "maximumDurationSeconds": 2700,
    "maximumOutputBytes": 10485760,
    "maximumProcesses": 64,
    "maximumMemoryBytes": 4294967296,
    "maximumCpuUnits": 2
  }
}
