{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-review:schemas:review-config.schema.json",
  "title": "ai-code-review project config",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planner", "worker", "control", "defaultEngine"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "planner": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "worker": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "control": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "defaultEngine": { "enum": ["fake", "codex", "claude"] }
  }
}
