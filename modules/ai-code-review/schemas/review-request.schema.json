{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:infoapex:ai-code:ai-code-review:schemas:review-request.schema.json",
  "title": "ai-code-review request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "reviewId", "baseCommit", "headCommit", "criteria"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "reviewId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "baseCommit": { "type": "string", "minLength": 1 },
    "headCommit": { "type": "string", "minLength": 1 },
    "graphVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "verify": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "symbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "controlContext": { "type": "string" }
  }
}
