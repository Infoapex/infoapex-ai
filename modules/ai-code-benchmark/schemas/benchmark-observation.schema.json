{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-observation-1.0.json", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "experimentHash", "taskId", "armId", "repetition", "status", "startedAt", "finishedAt", "telemetry", "failure"],
  "properties": {"schemaVersion": {"const": "1.0"}, "id": {"$ref": "#/$defs/id"}, "experimentHash": {"$ref": "#/$defs/hash"}, "taskId": {"$ref": "#/$defs/id"}, "armId": {"$ref": "#/$defs/id"}, "repetition": {"type": "integer", "minimum": 1}, "status": {"enum": ["DONE", "BLOCKED", "FAILED", "TIMEOUT"]}, "startedAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": ["string", "null"], "format": "date-time"}, "telemetry": {"type": "object", "additionalProperties": false, "required": ["providerLatencyMs", "harnessLatencyMs", "inputTokens", "outputTokens", "costUsd"], "properties": {"providerLatencyMs": {"type": ["integer", "null"], "minimum": 0}, "harnessLatencyMs": {"type": ["integer", "null"], "minimum": 0}, "inputTokens": {"type": ["integer", "null"], "minimum": 0}, "outputTokens": {"type": ["integer", "null"], "minimum": 0}, "costUsd": {"type": ["number", "null"], "minimum": 0}}}, "failure": {"type": ["object", "null"], "additionalProperties": false, "required": ["kind", "message"], "properties": {"kind": {"enum": ["provider-outage", "quota", "sandbox", "policy", "implementation", "timeout", "unknown"]}, "message": {"type": "string", "minLength": 1}}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
