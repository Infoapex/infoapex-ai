{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-environment-1.0.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "os", "architecture", "toolchain", "hardware", "cliVersions", "modulePins", "redactedConfiguration"],
  "properties": {"schemaVersion": {"const": "1.0"}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "os": {"type": "string", "minLength": 1}, "architecture": {"type": "string", "minLength": 1}, "toolchain": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}, "hardware": {"type": ["object", "null"], "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}, "cliVersions": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}, "modulePins": {"type": "object", "additionalProperties": {"type": "string"}}, "redactedConfiguration": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}}
}
