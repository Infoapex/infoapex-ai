{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-evaluation-1.0.json", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "experimentHash", "observationId", "taskId", "verdict", "gates", "oracle", "scope", "reviewer"],
  "properties": {"schemaVersion": {"const": "1.0"}, "id": {"$ref": "#/$defs/id"}, "experimentHash": {"$ref": "#/$defs/hash"}, "observationId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"}, "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]}, "gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "verdict"], "properties": {"id": {"type": "string", "minLength": 1}, "verdict": {"enum": ["PASS", "FAIL", "SKIP"]}, "evidenceRef": {"type": ["string", "null"]}, "exitCode": {"type": ["integer", "null"]}, "timedOut": {"type": "boolean"}, "outputTruncated": {"type": "boolean"}, "outputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "message": {"type": "string"}}}}, "oracle": {"type": "object", "additionalProperties": false, "required": ["verdict", "evidenceRef"], "properties": {"verdict": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "evidenceRef": {"type": ["string", "null"]}}}, "scope": {"type": "object", "additionalProperties": false, "required": ["verdict", "violations"], "properties": {"verdict": {"enum": ["PASS", "FAIL", "NOT_RUN"]}, "violations": {"type": "array", "items": {"type": "string"}}}}, "reviewer": {"type": ["object", "null"], "additionalProperties": false, "required": ["verdict", "note"], "properties": {"verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "note": {"type": "string"}}}, "evidence": {"type": "object", "additionalProperties": false, "required": ["diffSha256", "gateSha256", "changedPaths", "reasons"], "properties": {"diffSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "gateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "changedPaths": {"type": "array", "items": {"type": "string"}}, "reasons": {"type": "array", "items": {"type": "string"}}}}, "criticalSafetyFailure": {"type": "boolean"}, "adjudication": {"type": "object", "additionalProperties": false, "required": ["actor", "verdict", "reason"], "properties": {"actor": {"enum": ["human", "system"]}, "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]}, "reason": {"type": "string", "minLength": 1}}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
