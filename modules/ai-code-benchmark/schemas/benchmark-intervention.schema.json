{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-intervention-1.0.json", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "experimentHash", "observationId", "occurredAt", "kind", "actor", "activeMinutes", "reason"],
  "properties": {"schemaVersion": {"const": "1.0"}, "id": {"$ref": "#/$defs/id"}, "experimentHash": {"$ref": "#/$defs/hash"}, "observationId": {"$ref": "#/$defs/id"}, "occurredAt": {"type": "string", "format": "date-time"}, "kind": {"enum": ["setup", "diagnosis", "repair", "review", "adjudication"]}, "actor": {"enum": ["human", "system"]}, "activeMinutes": {"type": "number", "minimum": 0}, "reason": {"type": "string", "minLength": 1}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
