{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-task-1.0.json",
  "title": "AI Code Benchmark Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "risk", "languages", "difficulty", "inclusionReason", "prompt", "initialState", "setup", "scope", "verification", "oracle", "limits", "expectedOutcome", "dataClassification"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "kind": {"enum": ["mechanical-local", "bug-fix", "cross-file", "contract-api", "refactor", "documentation", "scope-risk", "dag-dependency", "recovery", "negative-blocked"]},
    "risk": {"enum": ["low", "medium", "high"]}, "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "difficulty": {"enum": ["easy", "medium", "hard"]}, "inclusionReason": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1}, "initialState": {"type": "object", "additionalProperties": false, "required": ["repository", "revision"], "properties": {"repository": {"$ref": "#/$defs/relativePath"}, "revision": {"type": "string", "minLength": 7}}},
    "setup": {"type": "array", "items": {"$ref": "#/$defs/boundedCommand"}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["allow", "deny"], "properties": {"allow": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}}, "deny": {"type": "array", "items": {"$ref": "#/$defs/relativePath"}}}},
    "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundedCommand"}},
    "oracle": {"type": "object", "additionalProperties": false, "required": ["access", "oracleRef"], "properties": {"access": {"const": "evaluator-only"}, "oracleRef": {"$ref": "#/$defs/relativePath"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["timeoutSeconds", "maximumOutputBytes"], "properties": {"timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "maximumOutputBytes": {"type": "integer", "minimum": 1}}},
    "expectedOutcome": {"enum": ["PASS", "BLOCKED"]}, "dataClassification": {"enum": ["public", "private-redacted"]}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9.][A-Za-z0-9._/-]*$"}, "boundedCommand": {"type": "object", "additionalProperties": false, "required": ["command", "timeoutSeconds"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}}}}
}
