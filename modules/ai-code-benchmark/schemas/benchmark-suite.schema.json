{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-suite-1.0.json",
  "title": "AI Code Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "taskFiles", "arms", "repetitions", "metrics", "thresholds", "budgets", "oracleAccess"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "kind": {"enum": ["generic", "private-manifest"]},
    "taskFiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
    "arms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "provider", "model", "effort"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["direct", "orchestrated-no-icm", "full-icm", "candidate"]}, "provider": {"type": ["string", "null"], "minLength": 1}, "model": {"type": ["string", "null"], "minLength": 1}, "effort": {"type": ["string", "null"], "minLength": 1}}}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["verified-task-success", "first-pass-success", "scope-safety", "human-active-minutes", "latency", "tokens", "cost-usd"]}},
    "thresholds": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["maximumInvocations", "maximumMinutes", "maximumCostUsd"], "properties": {"maximumInvocations": {"type": "integer", "minimum": 0}, "maximumMinutes": {"type": "integer", "minimum": 0}, "maximumCostUsd": {"type": ["number", "null"], "minimum": 0}}},
    "oracleAccess": {"const": "evaluator-only"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"}}
}
