{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://infoapex.dev/schemas/ai-code-benchmark/benchmark-report-1.0.json", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "experimentHash", "verdict", "aggregates", "limitations", "generatedAt"],
  "properties": {"schemaVersion": {"const": "1.0"}, "id": {"$ref": "#/$defs/id"}, "experimentHash": {"$ref": "#/$defs/hash"}, "verdict": {"enum": ["ACCEPT", "REJECT", "INCONCLUSIVE", "ACCEPT_WITH_LIMITS"]}, "aggregates": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/aggregate"}}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "generatedAt": {"type": "string", "format": "date-time"}, "experimentId": {"$ref": "#/$defs/id"}, "protocolHash": {"type": ["string", "null"]}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "comparison": {"type": "object"}, "categories": {"type": "object"}, "verdicts": {"type": "object"}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "aggregate": {"type": "object", "additionalProperties": false, "required": ["value", "lower", "upper", "unit"], "properties": {"value": {"type": ["number", "null"]}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}, "unit": {"type": "string"}, "sampleCount": {"type": "integer", "minimum": 0}, "validCount": {"type": "integer", "minimum": 0}, "missingCount": {"type": "integer", "minimum": 0}, "completeness": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "distribution": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}, "method": {"type": "string"}, "seed": {"type": ["string", "integer"]}}}}
}
