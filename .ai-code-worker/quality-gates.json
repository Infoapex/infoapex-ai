{
  "schemaVersion": "1.0",
  "gates": [
    {
      "id": "root-tests",
      "description": "Run the repository test suite with the checked-in dependency runtime.",
      "workingDirectory": ".",
      "executable": "npm",
      "args": ["test"],
      "timeoutSeconds": 900,
      "allowedEnvironmentVariables": ["PATH", "SystemRoot", "ComSpec", "TEMP", "TMP"],
      "linkedDirectories": [
        {
          "fromRepository": "node_modules",
          "toWorktree": "node_modules"
        }
      ]
    },
    {
      "id": "generic-boundary",
      "description": "Verify the generic module boundary contract.",
      "workingDirectory": ".",
      "executable": "npm",
      "args": ["run", "check:generic-boundary"],
      "timeoutSeconds": 120,
      "allowedEnvironmentVariables": ["PATH", "SystemRoot", "ComSpec", "TEMP", "TMP"],
      "linkedDirectories": [
        {
          "fromRepository": "node_modules",
          "toWorktree": "node_modules"
        }
      ]
    },
    {
      "id": "release-package-check",
      "description": "Verify the npm package contains only supported release content.",
      "workingDirectory": ".",
      "executable": "npm",
      "args": ["run", "release:package-check"],
      "timeoutSeconds": 120,
      "allowedEnvironmentVariables": ["PATH", "SystemRoot", "ComSpec", "TEMP", "TMP"],
      "linkedDirectories": [
        {
          "fromRepository": "node_modules",
          "toWorktree": "node_modules"
        }
      ]
    },
    {
      "id": "release-package-smoke",
      "description": "Install and exercise the built npm artifact in a disposable target.",
      "workingDirectory": ".",
      "executable": "npm",
      "args": ["run", "release:package-smoke"],
      "timeoutSeconds": 300,
      "allowedEnvironmentVariables": ["PATH", "SystemRoot", "ComSpec", "TEMP", "TMP"],
      "linkedDirectories": [
        {
          "fromRepository": "node_modules",
          "toWorktree": "node_modules"
        }
      ]
    }
  ]
}
