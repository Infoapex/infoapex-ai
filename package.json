{
  "name": "@infoapex/infoapex-ai",
  "version": "1.0.0-rc.1-internal",
  "private": true,
  "type": "module",
  "files": [
    "dist/src",
    "modules/ai-code-planner/dist/src",
    "modules/ai-code-planner/schemas",
    "modules/ai-code-worker/dist/src",
    "modules/ai-code-worker/schemas",
    "modules/ai-code-worker/templates",
    "modules/ai-code-review/dist/src",
    "modules/ai-code-review/schemas",
    "modules/ai-code-docs/dist/src",
    "modules/ai-code-docs/schemas",
    "modules/ai-code-benchmark/dist/src",
    "modules/ai-code-benchmark/schemas",
    "modules/ai-code-benchmark/datasets",
    "modules/ai-code-control/tools/ai-code-control/mcp-server",
    "modules/ai-code-control/tools/ai-code-control/src",
    "modules/provenance.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE-NOTES.md",
    "SECURITY.md"
  ],
  "bin": {
    "infoapex-ai": "dist/src/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup-bundle.mjs",
    "build": "npm run build:root && node scripts/build-bundle.mjs",
    "build:root": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "check:provenance": "node scripts/check-module-provenance.mjs",
    "generate:splash": "python scripts/splash/build.py",
    "check:generic-boundary": "node scripts/check-generic-boundary.mjs",
    "value-gate:internal": "node scripts/value-gate.mjs",
    "value-gate:live": "node scripts/value-gate.mjs --live",
    "p2:preflight": "node scripts/p2-live-preflight.mjs --fixture --json",
    "p2:preflight:live": "node scripts/p2-live-preflight.mjs --live --json",
    "pilot:icm-graph:internal": "node scripts/icm-graph-pilot.mjs",
    "p2b:pilot": "node scripts/p2-b-live-pilot.mjs --fixture --json",
    "p2b:pilot:live": "node scripts/p2-b-live-pilot.mjs --live --json",
    "review-gate:internal": "node scripts/review-gate.mjs",
    "docs-gate:internal": "node scripts/docs-gate.mjs",
    "release:build-zip": "node scripts/build-release-zip.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:package-check": "node scripts/check-npm-package.mjs",
    "release:package-smoke": "node scripts/package-smoke-test.mjs",
    "p6:verify": "node scripts/verify-p6.mjs",
    "p6:pilot:validate": "node scripts/validate-p6-pilot.mjs",
    "release:smoke-test": "node scripts/release-smoke-test.mjs",
    "release:public-preflight": "node scripts/public-release-preflight.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.0",
    "execa": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "adm-zip": "^0.6.0",
    "typescript": "^5.8.0"
  }
}
